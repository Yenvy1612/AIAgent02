# Optional local Compose database password. Change it before using Compose.
DIACARE_DB_PASSWORD=local-demo-only

# Optional neural RAG. Set to 1 to install the large FlagEmbedding/PyTorch stack in the image.
# Without the model stack, or if pgvector/model loading fails, the app falls back to local BM25/TF-IDF.
DIACARE_INSTALL_RAG_MODELS=0
# Install the pinned XGBoost/SHAP runtime when the selected model artifact needs it.
DIACARE_INSTALL_ML_MODELS=0
# NVIDIA GPU for neural RAG: uncomment these three lines, then rebuild. Keep FP16 true on a small GPU.
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# DIACARE_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu132
# DIACARE_BGE_FP16=true
DIACARE_RAG_MODE=auto
DIACARE_RAG_MIN_DENSE_SCORE=0.25
DIACARE_BGE_M3_MODEL=BAAI/bge-m3
DIACARE_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DIACARE_BGE_FP16=false
# Half precision applies to the embedding model only. It slowed the reranker about fivefold on a GTX 1650.
DIACARE_BGE_RERANK_FP16=false
DIACARE_BGE_RERANK_BATCH_SIZE=4
DIACARE_VECTOR_TABLE=kb_chunks
DIACARE_VECTOR_TIMEOUT_SECONDS=2
# Compose keeps model downloads in a named volume; this value is informational.
# HF_HOME=/root/.cache/huggingface

# Claude composition is off by default. The composer sends only approved KB excerpts,
# never the user's message, health measurements, tool output, or demo profile data.
DIACARE_LLM_ENABLED=false
DIACARE_ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Web fallback when the approved KB has no answer. Off by default. When on, a filtered query is
# sent to Anthropic and its search provider, and answers are labelled as unreviewed.
DIACARE_WEB_SEARCH_ENABLED=false
DIACARE_WEB_TIMEOUT_SECONDS=30
# Raw reranker logit below which a result is refused in neural mode. Calibrate before relying on it.
DIACARE_RAG_MIN_RERANK_SCORE=-6

# For local SQLite, DATABASE_URL can be omitted.
# DATABASE_URL=sqlite:///./data/diacare_demo.sqlite3
